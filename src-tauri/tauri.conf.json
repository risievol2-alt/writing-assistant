{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "砚习",
  "version": "../package.json",
  "identifier": "com.risievol2.inkstone",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev -- --no-open",
    "beforeBuildCommand": "pnpm build && pnpm tauri:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "publisher": "risievol2-alt",
    "shortDescription": "本地优先的个人写作训练助手",
    "longDescription": "砚习将写作训练、自动保存、作品管理、成长统计与动态人物档案整合为一个本地桌面应用。",
    "licenseFile": "../LICENSE",
    "resources": {
      "resources/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
